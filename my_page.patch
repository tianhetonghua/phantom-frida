+gsize
+gum_get_memory_region_size (gpointer* address)
+{
+  static gpointer cache_start = NULL;
+  static gpointer cache_end = NULL;
+
+  gpointer real_address = *address;
+  // __android_log_print(ANDROID_LOG_WARN, "PwnFRI", "Find Region %p",real_address);
+
+  if (real_address >= cache_start && real_address < cache_end)
+  {
+    *address = cache_start;
+    return (gsize) (cache_end - cache_start);
+  }
+
+  GumProcMapsIter iter;
+  const gchar * line;
+  gum_proc_maps_iter_init_for_self (&iter);
+  gsize result = 0;
+
+  while (gum_proc_maps_iter_next (&iter, &line))
+  {
+    gpointer start, end;
+    sscanf (line, "%p-%p", &start, &end);
+    if (start > real_address)
+      break;
+    else if (real_address >= start && real_address < end)
+    {
+      result = (gsize) (end - start);
+      *address = start;
+      // __android_log_print(ANDROID_LOG_WARN, "PwnFRI", "Find Region %p-%p %p",start,end,result);
+      cache_start = start;
+      cache_end = end;
+      break;
+    }
+  }
+  gum_proc_maps_iter_destroy (&iter);
+  return result;
+}
