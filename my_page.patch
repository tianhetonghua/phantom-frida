 {
-  /* TODO: update .so identity */
   return g_bytes_ref (so);
 }
+
+#ifdef __aarch64__
+int
+frida_soften_zygote_page (int pid, guint64 base, gsize page_size)
+{
+  struct regs { guint64 r[31], sp, pc, pstate; };
+  struct iovec iov;
+  struct regs orig, regs;
+  int st, mfd, ret = -1;
+  guint64 stub_addr = base + 0x800;
+  char mempath[64];
+  snprintf (mempath, sizeof (mempath), "/proc/%d/mem", pid);
+  mfd = open (mempath, O_RDWR);
+  if (mfd < 0) return -1;
+  {
+    guint32 stub[2] = { 0xd4000001, 0xd4200000 };
+    if (pwrite (mfd, stub, 8, (off_t) stub_addr) != 8) { close (mfd); return -1; }
+  }
+  close (mfd);
+  if (ptrace (PTRACE_ATTACH, pid, NULL, NULL) < 0) return -1;
+  waitpid (pid, &st, 0);
+  iov.iov_base = &orig;
+  iov.iov_len = sizeof (orig);
+  if (ptrace (PTRACE_GETREGSET, pid, (void *) 1, &iov) < 0) goto det;
+  if (iov.iov_len != sizeof (orig)) goto det;
+  regs = orig;
+  regs.r[8] = 226;
+  regs.r[0] = base;
+  regs.r[1] = page_size;
+  regs.r[2] = PROT_READ | PROT_EXEC;
+  regs.pc = stub_addr;
+  iov.iov_base = &regs;
+  iov.iov_len = sizeof (regs);
+  ptrace (PTRACE_SETREGSET, pid, (void *) 1, &iov);
+  {
+    int tries = 0;
+    do {
+      ptrace (PTRACE_CONT, pid, NULL, NULL);
+      waitpid (pid, &st, 0);
+    } while (WIFSTOPPED (st) && WSTOPSIG (st) == SIGSTOP && ++tries < 10);
+  }
+  iov.iov_base = &regs;
+  iov.iov_len = sizeof (regs);
+  if (ptrace (PTRACE_GETREGSET, pid, (void *) 1, &iov) == 0)
+    ret = (regs.r[0] == 0) ? 0 : -1;
+  iov.iov_base = &orig;
+  iov.iov_len = sizeof (orig);
+  ptrace (PTRACE_SETREGSET, pid, (void *) 1, &iov);
+det:
+  ptrace (PTRACE_DETACH, pid, NULL, NULL);
+  return ret;
+}
+#else
+int frida_soften_zygote_page (int pid, guint64 base, gsize page_size) { (void) pid; (void) base; (void) page_size; return 0; }
+#endif
